+// Harness patch: only final JSON is executable; streaming previews remain permissive.
+export function finalizeToolArguments(call, raw) {
+    try {
+        call.arguments = JSON.parse(raw);
+        call.argumentParseStatus = "valid";
+    } catch {
+        call.arguments = null;
+        call.argumentParseStatus = "invalid";
+    }
+}
